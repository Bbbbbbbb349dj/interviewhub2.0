# ── InterviewHub web app (Vite) build-time configuration ──────────────────

# Backend API (Express + PostgreSQL). When set, accounts & all data sync to
# PostgreSQL. Leave empty to run fully offline on the on-device database only
# (can also be set later in Settings → Server database).
VITE_API_URL=http://localhost:4000

# Optional: bake in AI keys (visible to anyone with the bundle — prefer the
# per-device keys in Settings). Users can always add their own key in-app.
# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_GEMINI_MODEL=gemini-3.6-flash
