# InterviewHub API configuration
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://interviewhub:interviewhub@localhost:5432/interviewhub

# JWT signing secret — set a long random value in production
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-free single origin or leave unset to reflect any origin (dev only)
# CORS_ORIGIN=https://your-interviewhub-app.example.com

# Server-side code execution provider key; never use a VITE_ prefix
ONLINECOMPILER_API_KEY=
