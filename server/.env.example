# InterviewHub API configuration
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://interviewhub:interviewhub@localhost:5432/interviewhub

# Public URL of the web app (used for reset links + Google redirect). No trailing slash.
APP_URL=http://localhost:5173

# Encrypts AI provider keys stored in PostgreSQL. Generate: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.6-flash

# Password-reset email (Resend). Without these, "Forgot password" reports it is unavailable.
RESEND_API_KEY=
MAIL_FROM=

# Google sign-in. Without these the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed when the web app runs on a different origin than the API (local dev), e.g. http://localhost:5173
# CORS_ORIGIN=

# Server-side code execution provider key; never use a VITE_ prefix
ONLINECOMPILER_API_KEY=
